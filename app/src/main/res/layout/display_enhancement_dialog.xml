<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#26282e"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

<LinearLayout
    android:id="@+id/LLDisplayEnhancement"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="18dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <ImageButton
            android:id="@+id/BTBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="left|center_vertical"
            android:background="@android:color/transparent"
            android:src="@drawable/icon_action_bar_back"
            android:tint="#f0f0f0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/display_enhancement"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/LLPictureStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="82dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picture_style"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/picture_style_summary"
                android:textColor="#a8a8ad"
                android:textSize="14sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/SPictureStyle"
            android:layout_width="150dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLFrameInterpolation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="82dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smart_frame_interpolation"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/smart_frame_interpolation_summary"
                android:textColor="#a8a8ad"
                android:textSize="14sp" />
        </LinearLayout>

        <Spinner
            android:id="@+id/SFrameInterpolation"
            android:layout_width="150dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#50535c" />

    <LinearLayout
        android:id="@+id/LLShowFPS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="74dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_fps"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/show_fps_summary"
                android:textColor="#a8a8ad"
                android:textSize="14sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/SWShowFPS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLDisplayFpsLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="74dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_fps_limit"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/display_fps_limit_summary"
                android:textColor="#a8a8ad"
                android:textSize="14sp" />
        </LinearLayout>

        <com.winlator.widget.SeekBar
            android:id="@+id/SBDisplayFpsLimit"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            app:minValue="0"
            app:maxValue="240"
            app:step="1"
            app:suffix=" FPS"
            app:zeroLabel="@string/zero_no_limit" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLGameFpsLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_fps_limit"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/game_fps_limit_summary"
                android:textColor="#a8a8ad"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.winlator.widget.SeekBar
                android:id="@+id/SBGameFpsLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:minValue="0"
                app:maxValue="240"
                app:step="1"
                app:suffix=" FPS"
                app:zeroLabel="@string/zero_no_limit" />

            <Button
                android:id="@+id/BTSyncGameFpsLimit"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="=显示输出"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp"
        android:background="#5a5d66" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:text="@string/display_enhancement_notice"
        android:textColor="#ffffff"
        android:textSize="14sp" />
</LinearLayout>
</ScrollView>
